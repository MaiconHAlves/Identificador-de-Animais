---------------------
Arquivo: .github/workflows/android.yml

ANTES:
  sudo rm -rf $ANDROID_HOME/tools
  sudo ln -s $ANDROID_HOME/cmdline-tools/16.0 $ANDROID_HOME/cmdline-tools/latest || true

DEPOIS:
  sudo ln -sf $ANDROID_HOME/cmdline-tools/16.0 $ANDROID_HOME/cmdline-tools/latest || true
  sudo mkdir -p $ANDROID_HOME/tools/bin
  sudo ln -sf $ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager $ANDROID_HOME/tools/bin/sdkmanager
  sudo ln -sf $ANDROID_HOME/cmdline-tools/latest/bin/avdmanager $ANDROID_HOME/tools/bin/avdmanager
  sudo chmod +x $ANDROID_HOME/tools/bin/sdkmanager

